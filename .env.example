# Copie para .env e preencha. O .env não vai para o Git.

# API (usado pelo docker compose e pelo `npm run dev:api`)
API_PORT=3000
MONGO_URL=mongodb://localhost:27017/checkins
CORS_ORIGIN=*
# ID do projeto no Firebase (o mesmo de EXPO_PUBLIC_FIREBASE_PROJECT_ID no app)
FIREBASE_PROJECT_ID=

# Cloudflare Tunnel (só para expor a API na internet)
CLOUDFLARE_TUNNEL_TOKEN=

# Testes da API contra um MongoDB real (docker compose up -d mongo)
MONGO_URL_TEST=mongodb://localhost:27017/checkins_test
