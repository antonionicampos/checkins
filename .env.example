# Copie para .env e preencha. O .env não vai para o Git.

# API (lido por `npm run dev:api` e `npm start -w @checkins/api`)
PORT=3000
# Desenvolvimento: o MongoDB desta máquina. Produção: o servidor da rede local,
# ex.: mongodb://usuario:senha@192.168.0.20:27017/checkins?authSource=admin
MONGO_URL=mongodb://localhost:27017/checkins
CORS_ORIGIN=*
# ID do projeto no Firebase (o mesmo de EXPO_PUBLIC_FIREBASE_PROJECT_ID no app)
FIREBASE_PROJECT_ID=

# Pasta onde a API guarda fotos e cardápios (no disco da máquina de casa).
# Vazio usa media/ na raiz do repositório.
# MEDIA_DIR=/home/antonioni/checkins-media

# Testes da API: um banco separado (o nome precisa ter "test"; os testes apagam os dados dele)
MONGO_URL_TEST=mongodb://localhost:27017/checkins_test
