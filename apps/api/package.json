{
  "name": "@checkins/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do app: Fastify + MongoDB + Socket.IO",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@checkins/shared": "*",
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "mongoose": "^9.11.2",
    "socket.io": "^4.8.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
}
