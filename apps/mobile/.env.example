# Copie para apps/mobile/.env. Nenhum destes valores é segredo (vão dentro do app).

# IP da máquina que roda a API, visto pelo celular na mesma rede Wi-Fi.
# Em produção, o endereço público do Cloudflare Tunnel (ex.: https://api.seudominio.com.br).
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Firebase: Console > Configurações do projeto > Seus apps > app da Web > firebaseConfig
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Login com Google: ID do cliente OAuth do tipo "Web" que o Firebase cria
# (Authentication > Método de login > Google > Configuração do SDK da Web).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Só para iPhone: "reversed client ID" do cliente iOS (com.googleusercontent.apps....).
GOOGLE_IOS_URL_SCHEME=

# Notificações push: ID do projeto no EAS (expo.dev > projeto > Project ID, ou `npx eas init`).
# Sem ele o app funciona, só não recebe notificações.
EXPO_PUBLIC_EAS_PROJECT_ID=
