# .env de produção da API na Debian. Copie para /opt/checkins/.env (dono checkins, permissão 600).
# Lido pelo serviço checkins-api, pelo backup e pelos comandos npm (moderação, importar lugares).

NODE_ENV=production
# Só a própria máquina acessa a API; a internet chega pelo Cloudflare Tunnel.
HOST=127.0.0.1
PORT=3000

# MongoDB nesta mesma Debian, com o usuário criado no guia (deploy/README.md).
# Troque SENHA pela senha gerada (só letras e números, para não precisar escapar nada na URL).
MONGO_URL=mongodb://checkins:SENHA@127.0.0.1:27017/checkins?authSource=checkins

# O app no celular não usa CORS; "*" não abre nada além do que a API já expõe.
CORS_ORIGIN=*

# Mesmo valor do .env de desenvolvimento (ID do projeto no Firebase).
FIREBASE_PROJECT_ID=

# Fotos e cardápios. O systemd cria /var/lib/checkins com o dono certo.
MEDIA_DIR=/var/lib/checkins/media

# Backup diário (deploy/backup.sh): onde guardar e por quantos dias.
BACKUP_DIR=/var/lib/checkins/backups
BACKUP_KEEP_DAYS=14

# Opcional: só se ativar "Enhanced security for push notifications" no expo.dev.
EXPO_ACCESS_TOKEN=

LOG_LEVEL=info
