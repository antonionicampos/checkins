{
  "name": "checkins",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @checkins/shared",
    "predev:api": "npm run build -w @checkins/shared",
    "dev:api": "npm run dev -w @checkins/api",
    "predev:mobile": "npm run build -w @checkins/shared",
    "dev:mobile": "npm run start -w @checkins/mobile",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11"
  },
  "packageManager": "npm@11.21.1",
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
